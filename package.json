{
  "name": "actracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:web": "TRACKER_MODE=web next dev",
    "dev:tracker": "TRACKER_MODE=tracker next dev",
    "build": "next build",
    "start": "node --max-old-space-size=280 --max-semi-space-size=16 ./node_modules/next/dist/bin/next start",
    "start:web": "TRACKER_MODE=web npm start",
    "start:tracker": "TRACKER_MODE=tracker npm start",
    "lint": "eslint"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@neon/config": "^1.9.1",
    "@neondatabase/auth": "^0.6.0-beta",
    "@supabase/server": "^1.9.2",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
