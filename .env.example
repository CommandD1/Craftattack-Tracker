# PostgreSQL-Verbindung
# DATABASE_URL=postgres://user:pass@localhost:5432/actracker

# Neon Managed Auth: NEON_AUTH_BASE_URL kommt von `neon env pull`.
# NEON_AUTH_COOKIE_SECRET mit `openssl rand -base64 32` erzeugen (mindestens 32 Zeichen).
# NEON_AUTH_COOKIE_SECRET=
# Neon Object Storage verwendet AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# AWS_ENDPOINT_URL_S3 und AWS_REGION aus `neon env pull`.

# Twitch-App (https://dev.twitch.tv/console/apps): Live-Status aller bekannten Streamer direkt von Twitch (auch ohne Server),
# Zuschauerzahlen und VOD-Links an Toden und Stream-Ereignissen. Leer = Live-Status nur aus der Haupt-API, keine VOD-Links.
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# Twitch-IRC für Abo-Benachrichtigungen (optional; Twitch-OAuth-Token mit chat:read empfohlen).
# Alle bekannten Kanäle werden mit maximal 20 JOINs pro 10 Sekunden (einer alle 500 ms) abonniert.
# TWITCH_IRC_NICK=
# TWITCH_IRC_TOKEN=

# Geheimnis für /api/cron/poll (z. B. mit `openssl rand -hex 32` erzeugen).
# CRON_SECRET=

# Minuten ohne Streckenzuwachs, bevor Online-Spieler als AFK gelten (Standard: 20).
# CA_AFK_MINUTES=20
